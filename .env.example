# Copy this file to .env and fill in the values. .env is never committed.
#
#   cp .env.example .env
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# The development key and the production key are two different keys. The
# production one is generated on the deployment platform and lives only in its
# environment variables — it never lands in a file.

DJANGO_SECRET_KEY=

# True on a development machine, False everywhere else. Anything other than
# 1/true/yes is treated as False.
DJANGO_DEBUG=True

# Comma separated. Empty means "no host is allowed", which is the correct
# failure mode in production; dev.py overrides it for localhost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection URL. Replace <user> with your local username; on a
# managed platform (Render / Fly.io) this variable is injected for you.
#   createdb rolf_dev
DATABASE_URL=postgres://<user>@localhost:5432/rolf_dev

# --- Rate limiting ----------------------------------------------------------
# How many accounts may be created per hour, from one address and in total. Both
# are deliberately generous: forty volunteers on one church-hall wifi are one
# address, and a script wants thousands. Raise them for a signup drive; a
# restart is enough, no deploy.
REGISTRATION_RATELIMIT_PER_IP=20/h
REGISTRATION_RATELIMIT_SITE=100/h

# Whether X-Forwarded-For may be believed. Leave this False on a development
# machine and anywhere the app is reachable directly: with nothing in front of
# it, a caller can put any address in that header and walk around the limit.
# prod.py sets it True because the deployment runs behind Render's proxy, where
# REMOTE_ADDR is the proxy and every visitor would otherwise share one bucket.
TRUST_PROXY_CLIENT_IP=False

# --- Uploaded files: Cloudflare R2 -------------------------------------------
# Read by config/settings/prod.py only. A development machine keeps every upload
# on the local disk (config/settings/base.py), so these stay empty here and the
# test suite reaches no network.
#
# ⚠️ prod.py refuses to start without them, deliberately. The alternative —
#    falling back to local disk — is the silent failure: Render wipes its disk
#    on every deploy, so photos would disappear at a random moment that looks
#    like a bug rather than like a missing setting.
#
# ⚠️ **Four buckets, and the split is a requirement.** Each answers "who may
#    read this" and "may a delete be undone" differently, and no bucket can hold
#    two answers:
#
#      backups          private, and NOT named here — the backup script talks to
#                       R2 itself (C3.6). It holds minors' data in the clear.
#      event images     private. ⚠️ Versioning OFF: with it on,
#                       purge_event_images' delete is only a marker and the old
#                       version is still there, while the console shows the
#                       object as deleted.
#      memories         private. ⚠️ Versioning ON — the exact opposite, which is
#                       why it cannot share the bucket above. These are the only
#                       files in the system that the pg_dump cannot restore.
#      public           public. The front page's picture and video, which are
#                       public by definition — that page needs no login.
#
# The endpoint is https://<account id>.r2.cloudflarestorage.com — one per
# account, not one per bucket.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_EVENT_IMAGES=
R2_BUCKET_MEMORIES=
R2_BUCKET_PUBLIC=
# The hostname the public bucket is served on — an r2.dev subdomain or a custom
# domain. Host only, no scheme and no trailing slash.
R2_PUBLIC_BASE_HOST=

# --- Google sign-in (prefill only) ------------------------------------------
# The OAuth 2.0 Client ID (Web) for the "Continue with Google" button on the
# registration page. It fills in email / first name / last name and grants
# nothing — the account is still a password account. Leave it empty and the
# button is not drawn at all.
#
# There is no client *secret* in this flow. Getting the id: Google Cloud Console
# -> APIs & Services -> Credentials -> Create OAuth client ID -> Web
# application, with Authorized JavaScript origins set to http://localhost:8000
# for development and the real origin once there is one.
GOOGLE_OAUTH_CLIENT_ID=
